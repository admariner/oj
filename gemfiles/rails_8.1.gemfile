# frozen_string_literal: true

source 'https://rubygems.org'

gem 'rails', '~> 8.1.0'
# ActiveSupport 8.1.3.1 calls ::JSON.parse(json, options) with a positional
# Hash, which json 3.0 (released 2026-09-07) no longer accepts, so every
# activesupport8.1 decoding test raises ArgumentError on json 3. Rails fixed
# this on 8-1-stable in https://github.com/rails/rails/pull/58601 but has not
# released it yet. Drop this pin once a released 8.1.x carries that fix.
gem 'json', '< 3'
gem 'sqlite3'
gem 'mutex_m'
gem 'base64'
gem 'drb'
# Windows has no system zoneinfo, so ActiveSupport::TimeZone cannot resolve a
# zone without this. The activesupport8.1 tests need it, the same way the
# rails_8 gemfile does. Written as a conditional rather than :platforms so that
# it works on every bundler: the :windows platform needs bundler 2.5 and the
# older :mingw/:mswin/:x64_mingw spelling is deprecated.
gem 'tzinfo-data' if Gem.win_platform?

gemspec :path => '../'
